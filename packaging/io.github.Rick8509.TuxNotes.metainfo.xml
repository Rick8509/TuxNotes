<?xml version="1.0" encoding="UTF-8"?>
<!-- App store information (AppStream). Installed to /usr/share/metainfo/ by every package.
     The release tool (scripts/release.mjs) adds a <release> entry for each version. -->
<component type="desktop-application">
  <id>io.github.Rick8509.TuxNotes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>TuxNotes</name>
  <summary>Write and organize notes, checklists and tables</summary>
  <developer id="io.github.rick8509">
    <name>Rick8509</name>
  </developer>

  <description>
    <p>
      TuxNotes is a clean, fast notes app for Linux. Notes are kept in folders on your
      computer and saved as you type. Everything works offline.
    </p>
    <p>Features:</p>
    <ul>
      <li>Folders and subfolders, pinned notes and a Recently Deleted folder</li>
      <li>Headings, lists, checklists, tables, links and code blocks in colour</li>
      <li>Slash commands: type / to insert anything</li>
      <li>Images you can resize, crop and rotate, and file attachments</li>
      <li>Instant search across all notes, and a command palette for every action</li>
      <li>Spell checking in your languages</li>
      <li>Password-locked notes, encrypted on your computer</li>
      <li>Automatic backups to a USB drive or a synced folder, optionally encrypted</li>
      <li>Open text, code and Markdown files in a tabbed editor with syntax colours</li>
      <li>Export to Markdown or PDF, print, and import Markdown files</li>
      <li>Light and dark look, keyboard shortcuts for everything</li>
    </ul>
  </description>

  <launchable type="desktop-id">TuxNotes.desktop</launchable>
  <provides>
    <binary>tuxnotes</binary>
  </provides>

  <categories>
    <category>Office</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>notes</keyword>
    <keyword>notebook</keyword>
    <keyword>checklist</keyword>
    <keyword>to-do</keyword>
    <keyword>markdown</keyword>
  </keywords>

